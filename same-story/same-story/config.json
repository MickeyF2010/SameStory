{
  "site": {
    "title": "Same Story",
    "tagline": "One UK politics story, as left-leaning, centre and right-leaning outlets each headline it.",
    "contact_url": "mailto:michaelfielduk@gmail.com",
    "lean_rating_note": "Labels come from AllSides Media Bias Ratings (checked October 2026) and are grouped into three columns: Left and Lean Left appear as left-leaning, Center as centre, and Lean Right and Right as right-leaning. AllSides rates by the average judgment of mostly American reviewers, so its scale may not match how UK readers see these outlets, and several UK ratings are marked low confidence. GB News has no AllSides rating, so Media Bias/Fact Check's rating is used instead."
  },
  "settings": {
    "max_age_hours": 48,
    "per_feed_limit": 200,
    "min_outlets": 3,
    "required_leans": [
      "left",
      "right"
    ],
    "max_stories": 20,
    "summary_max_chars": 240
  },
  "matching": {
    "method": "tfidf",
    "tfidf_threshold": 0.3,
    "embedding_threshold": 0.8
  },
  "llm": {
    "provider": "gemini",
    "model": "gemini-3.5-flash-lite",
    "base_url": "https://openrouter.ai/api/v1",
    "request_delay_seconds": 6.5,
    "max_calls_per_run": 25,
    "retry_failed_after_hours": 6
  },
  "sources": [
    {
      "id": "guardian",
      "name": "The Guardian",
      "lean": "left",
      "feeds": [
        "https://www.theguardian.com/politics/rss"
      ],
      "rating": "AllSides: Left (low confidence)"
    },
    {
      "id": "newstatesman",
      "name": "New Statesman",
      "lean": "left",
      "enabled": false,
      "feeds": [
        "https://www.newstatesman.com/politics/feed"
      ],
      "rating": ""
    },
    {
      "id": "bbc",
      "name": "BBC News",
      "lean": "centre",
      "feeds": [
        "https://feeds.bbci.co.uk/news/politics/rss.xml"
      ],
      "rating": "AllSides: Center (medium confidence)"
    },
    {
      "id": "sky",
      "name": "Sky News",
      "lean": "left",
      "feeds": [
        "https://feeds.skynews.com/feeds/rss/politics.xml"
      ],
      "rating": "AllSides: Lean Left (low confidence)"
    },
    {
